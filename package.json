{
  "name": "greenloop-waste-logistics",
  "version": "4.0.0",
  "description": "Automated Waste Logistics & Fleet Management — Majari UAE (MongoDB + Prisma)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && node scripts/create-indexes.js",
    "db:push": "prisma db push",
    "db:indexes": "node scripts/create-indexes.js",
    "db:check": "node scripts/check-db.js",
    "db:studio": "prisma studio",
    "db:migrate-sqlite": "node scripts/migrate-sqlite-to-mongo.js",
    "build:crm": "cd crm-react && npm install && npm run build",
    "dev:crm": "cd crm-react && npm run dev",
    "test": "node test/run.js",
    "test:mongo": "node scripts/test-mongo.js",
    "test:e2e": "node test/e2e.js",
    "test:load": "node --no-warnings test/perf/load.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "prisma": "^6.16.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
