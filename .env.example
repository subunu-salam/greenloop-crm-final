# ─────────────────────────────────────────────────────────────
# GreenLoop settings. Copy this file to ".env" (same folder) and fill it in.
# .env is in .gitignore — never commit real passwords.
# ─────────────────────────────────────────────────────────────

# MongoDB connection (Prisma reads this).
# Local MongoDB Community Server started as replica set "rs0" (see docs/MONGODB-SETUP.md):
DATABASE_URL="mongodb://127.0.0.1:27017/greenloop?replicaSet=rs0&directConnection=true"
# MongoDB Atlas (cloud) looks like:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/greenloop?retryWrites=true&w=majority"

# Optional: the database `npm run test:mongo` uses (emptied on every test run!)
# TEST_DATABASE_URL="mongodb://127.0.0.1:27017/greenloop_test?replicaSet=rs0&directConnection=true"

PORT=3000
# Login tokens are signed with this. Leave empty locally (one is generated in data/),
# set a long random value in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin password (only used the very first time the database is seeded)
ADMIN_PASSWORD=admin123

# Daily JSON backup of all collections is written here (optional)
# BACKUP_DIR=./backups

# Print every Prisma query in the terminal while learning/debugging
# PRISMA_LOG=1
