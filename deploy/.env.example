# Copy this file to .env in the same folder and fill in real values.

# Your domain, e.g. ops.greenloop.ae — DNS A record must point at this server first
DOMAIN=ops.example.com

# Long random secret for login tokens. Generate one with:
#   openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string

# ── Gmail for quotations (v3.2) — choose A or B ──
# A) App password:  Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# B) Gmail API (if outbound SMTP is blocked): OAuth client with gmail.send scope
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM_NAME=GreenLoop

# ── One-time sign-in codes (v3.3) ──
# Codes are emailed through the Gmail account above. While Gmail is NOT connected the
# customer app shows the code on screen (demo mode). Set OTP_DEV=0 to turn that off.
OTP_DEV=0
